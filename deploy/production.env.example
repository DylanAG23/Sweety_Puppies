# Copiar fuera del repositorio, completar y mantener privado.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_BASE_URL=https://tu-dominio.example
CORS_ORIGINS=
# false = acceso directo. IP/subredes del proxy o numero de saltos conocido.
# No usar 1 si tambien se puede acceder al backend sin pasar por ese proxy.
TRUST_PROXY=false
JWT_SECRET=
APPOINTMENT_ACTION_SECRET=
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=postgres
DB_POOL_MAX=5
SUPABASE_URL=
SUPABASE_KEY=
BUCKET_NAME=imagenes
# gmail (SMTP Gmail), remote (API HTTPS de Resend) o disabled (sin envios).
# En disabled, registro y recuperacion por correo no estaran disponibles.
MAIL_MODE=gmail
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM=
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
MAIL_EXPOSE_DEV_CODES=false
