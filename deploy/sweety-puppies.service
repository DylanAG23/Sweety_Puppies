[Unit]
Description=Sweety Puppies
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sweety
Group=sweety
WorkingDirectory=/opt/sweety-puppies
EnvironmentFile=/etc/sweety-puppies.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node scripts/start-production.cjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
