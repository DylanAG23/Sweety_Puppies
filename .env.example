# Copia este archivo como .env y completa los valores. Nunca subas .env a git.

# --- Servidor ---
PORT=3000
# production | development
NODE_ENV=development
# URL publica del backend (se usa en los enlaces de los correos)
APP_BASE_URL=http://localhost:3000
# Origenes permitidos para CORS, separados por coma (vacio = solo el mismo origen)
CORS_ORIGINS=http://localhost:5173

# --- Seguridad (obligatorias) ---
# Genera valores largos y aleatorios, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
APPOINTMENT_ACTION_SECRET=

# --- Base de datos PostgreSQL (Supabase > Project Settings > Database) ---
# Opcion A: cadena completa
DATABASE_URL=
# Opcion B: campos separados (se usan si DATABASE_URL esta vacia)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=postgres
# Conexiones maximas del pool
DB_POOL_MAX=10

# --- Supabase Storage (solo backend; el frontend nunca consulta Supabase) ---
SUPABASE_URL=
SUPABASE_KEY=
BUCKET_NAME=imagenes

# --- Correo ---
# gmail | smtp | remote (Resend) | local (escribe en temp/verification-codes.log)
MAIL_MODE=local
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM=
RESEND_API_KEY=
# Correo que recibe las solicitudes de citas (por defecto MAIL_USER)
ADMIN_NOTIFICATION_EMAIL=
# Solo desarrollo: devuelve el codigo de verificacion en la respuesta de la API.
# Nunca se aplica con NODE_ENV=production.
MAIL_EXPOSE_DEV_CODES=false
